{
  "name": "suanzhun-web",
  "version": "0.10.2",
  "private": true,
  "description": "算的准：传统命理文化参考工具",
  "type": "module",
  "scripts": {
    "check": "node scripts/verify.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "node scripts/serve.mjs",
    "assets": "node scripts/build-assets.mjs",
    "deploy": "node scripts/deploy.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "test": "node --test tests/*.test.mjs",
    "release:check": "npm run lint && npm run format:check && npm run secret-scan && npm run check && npm run contrast && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7"
  }
}
